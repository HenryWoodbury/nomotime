---
import '../styles/global.css';
import logo from '../nomo-logo.svg?raw';
import { IS_BETA, LEGAL_PAGES, SITE_NAME, SUPPORT_EMAIL } from '../site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Astro.url.pathname is /privacy.html under build.format 'file'; routePattern is
// already the clean route.
const path = Astro.routePattern;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/Lato-Regular-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/CrimsonText-SemiBold-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Lato-Bold-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/app-icon.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="masthead">
      <div class="shell">
        <a class="wordmark" href="/">
          <Fragment set:html={logo} />
          {SITE_NAME}
        </a>
        {IS_BETA && <span class="beta-tag">Beta</span>}
        <nav>
          {
            LEGAL_PAGES.map((item) => (
              <a
                href={item.href}
                aria-current={
                  path === item.href
                    ? 'page'
                    : path.startsWith(`${item.href}/`)
                      ? 'true'
                      : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="colophon">
      <div class="shell">
        <span>&copy; {new Date().getFullYear()} Henry Woodbury. All rights reserved.</span>
        <nav>
          {LEGAL_PAGES.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
