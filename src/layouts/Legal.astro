---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    updated: string;
    version: string;
  };
}

const { title, description, updated, version } = Astro.props.frontmatter;

// Markdown frontmatter is untyped YAML; the Props interface above documents it
// but nothing enforces it. These two are cited in the Play listing.
for (const [key, value] of Object.entries({ title, description, updated, version })) {
  if (!value) throw new Error(`${Astro.url.pathname}: frontmatter is missing "${key}"`);
}
---

<Base title={`${title} — Metronomo`} description={description}>
  <div class="shell">
    <article class="prose">
      <h1>{title}</h1>
      <p class="stamp">Version {version} &middot; Last updated {updated}</p>
      <slot />
    </article>
  </div>
</Base>
