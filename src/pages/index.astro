---
import { getImage } from 'astro:assets';

import Base from '../layouts/Base.astro';
import darkShot from '../assets/MetronomoDarkMode.png';
import lightShot from '../assets/MetronomoLightMode.png';
import { IS_BETA, IS_SOON, PLAY_BETA_URL, TESTFLIGHT_URL } from '../site';

// The shot is themed against the page rather than with it: the dark screenshot
// carries the light page, and the light screenshot carries the dark one. Both
// are 1080x2400, so one width/height on the img reserves the box for either and
// the swap costs no layout shift; keep them the same size when either is redrawn.
const shot = {
  width: 672,
  widths: [336, 672],
  sizes: '(max-width: 46rem) 17rem, 21rem',
  format: 'webp' as const,
};
const onLight = await getImage({ src: darkShot, ...shot });
const onDark = await getImage({ src: lightShot, ...shot });

const features = [
  {
    title: 'Hardware clock',
    body: 'Clicks queued to your device’s audio clock, not to a software timer.',
  },
  {
    title: '16 beats a bar',
    body: 'Set each beat strong, medium, soft, tick, or mute to build any rhythm.',
  },
  {
    title: '20–480 BPM',
    body: 'Sweep to the range you want, then fine-tune to the exact tempo.',
  },
  {
    title: 'Custom subdivisions',
    body: 'Up to 8 ticks including the beat, each accented independently.',
  },
  {
    title: 'Multiple timers',
    body: 'Set count-in, alarm, and pause timers to match your routine.',
  },
  {
    title: 'Grooves you reuse',
    body: 'Save any pattern of tempo, accents, subdivisions, and timers.',
  },
];
---

<Base
  title="Metronomo — a precise, offline metronome for musicians"
  description="A metronome for any meter, built on beats and accents, scheduled against the audio hardware clock so the click does not drift. Free on iOS and Android, works entirely offline."
>
  <div class="shell">
    <section class="hero">
      <div>
        {IS_SOON && <p class="hero-status">Coming soon</p>}
        {IS_BETA && <p class="hero-status">Now in beta testing</p>}
        <h1>The bot that bops</h1>
        <p class="lede">
          Metronomo is a metronome for any meter. Set the beats, accent them however you like,
          add a custom subdivision pattern, and syncopate your groove.
        </p>
        {!IS_SOON && (PLAY_BETA_URL || TESTFLIGHT_URL) && (
          <div class="cta-row">
            {PLAY_BETA_URL && (
              <a class="cta" href={PLAY_BETA_URL}>
                Join the Android beta
              </a>
            )}
            {TESTFLIGHT_URL && (
              <a class="cta" href={TESTFLIGHT_URL}>
                Join the iOS beta
              </a>
            )}
          </div>
        )}
        <ul class="cta-list">
          <li>Free foundational engine, 20–480 BPM</li>
          <li>No ads, no signup, no personal info</li>
          <li>Local to your device; no signal is no problem</li>
        </ul>
      </div>
      <div class="hero-shot">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset={onDark.srcSet.attribute}
            sizes={shot.sizes}
            type="image/webp"
          />
          <img
            src={onLight.src}
            srcset={onLight.srcSet.attribute}
            sizes={shot.sizes}
            width={onLight.attributes.width}
            height={onLight.attributes.height}
            alt="Metronomo’s main screen, showing the beat row, tempo slider, and transport controls"
            decoding="async"
          />
        </picture>
      </div>
    </section>
  </div>

  <div class="shell">
    <dl class="features">
      {
        features.map((feature) => (
          <div>
            <dt>{feature.title}</dt>
            <dd>{feature.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="shell">
    <section class="section">
      <h2>Your practice is your business</h2>
      <p class="sub">
        Metronomo needs no buy-in, other than the buy-in of giving it a try:
      </p>
      <ul class="privacy-list">
        <li>No name, no email address, no personal information of any kind</li>
        <li>No cloud; your Grooves stay on your device</li>
        <li>No recording — Metronomo makes sound, it never listens</li>
        <li>No ads, no tracking</li>
        <li>
          Yes to anonymous, optional analytics (see <a href="/privacy">Privacy Policy</a>)
        </li>
      </ul>
    </section>
  </div>
</Base>
