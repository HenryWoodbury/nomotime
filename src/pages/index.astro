---
import { getImage } from 'astro:assets';

import Base from '../layouts/Base.astro';
import darkShot from '../assets/MetronomoDarkMode.png';
import lightShot from '../assets/MetronomoLightMode.png';
import { BETA_URL, IS_BETA, IS_SOON } from '../site';

// The shot is themed against the page rather than with it: the dark screenshot
// carries the light page, and the light screenshot carries the dark one. Both
// are 1080x2400, so one width/height on the img reserves the box for either and
// the swap costs no layout shift; keep them the same size when either is redrawn.
const shot = {
  width: 672,
  widths: [336, 672],
  sizes: '(max-width: 46rem) 17rem, 21rem',
  format: 'webp' as const,
};
const onLight = await getImage({ src: darkShot, ...shot });
const onDark = await getImage({ src: lightShot, ...shot });

const features = [
  {
    title: 'Hardware clock',
    body: 'Uses your device’s audio clock for the best precision.',
  },
  {
    title: '16 beats a bar',
    body: 'Accent each beat to generate unique rhythms.',
  },
  {
    title: '20–480 BPM',
    body: 'Quickly fine-tune to specific tempos.',
  },
  {
    title: 'Custom subdivisions',
    body: 'Add a custom subdivision pattern to the beat of up to eight ticks.',
  },
  {
    title: 'Multiple timers',
    body: 'Set count-in, alarm, and pause timers to match your routine.',
  },
  {
    title: 'Grooves you reuse',
    body: 'Save any pattern of tempo, accents, subdivisions, and timers for later.',
  },
];
---

<Base
  title="Metronomo — a precise, offline metronome for musicians"
  description="A metronome built on beats and accents, scheduled against the audio hardware clock so the click does not drift. Free on Android, works entirely offline."
>
  <div class="shell">
    <section class="hero">
      <div>
        {IS_SOON && <p class="hero-status">Coming soon</p>}
        {IS_BETA && <p class="hero-status">Now in beta testing</p>}
        <h1>The bot that bops</h1>
        <p class="lede">
          Metronomo lets you set the beats and subdivisions for your personal practice requirements.
          Avoid the noise and syncopate your groove.
        </p>
        {!IS_SOON && <a class="cta" href={BETA_URL}>Join the beta</a>}
        <ul class="cta-list">
          <li>Free foundational engine, 20–480 BPM</li>
          <li>No ads, no signup, no personal info</li>
          <li>Local to your device; no signal is no problem</li>
        </ul>
      </div>
      <div class="hero-shot">
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset={onDark.srcSet.attribute}
            sizes={shot.sizes}
            type="image/webp"
          />
          <img
            src={onLight.src}
            srcset={onLight.srcSet.attribute}
            sizes={shot.sizes}
            width={onLight.attributes.width}
            height={onLight.attributes.height}
            alt="Metronomo’s main screen, showing the beat row, tempo slider, and transport controls"
            decoding="async"
          />
        </picture>
      </div>
    </section>
  </div>

  <div class="shell">
    <dl class="features">
      {
        features.map((feature) => (
          <div>
            <dt>{feature.title}</dt>
            <dd>{feature.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="shell">
    <section class="section">
      <h2>Your practice is your business</h2>
      <p class="sub">
        Metronomo needs no buy-in, other than the buy-in of giving it a try:
      </p>
      <ul class="privacy-list">
        <li>No name, no email address, no personal information of any kind</li>
        <li>No creative work saved in the cloud; your grooves stay on your device</li>
        <li>No microphone permission; Metronomo makes sound; it never listens</li>
        <li>No ads, no tracking</li>
        <li>
          Yes to anonymous, optional, analytics (see <a href="/privacy">Privacy Policy</a>)
        </li>
      </ul>
    </section>
  </div>
</Base>
