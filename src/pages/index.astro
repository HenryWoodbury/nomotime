---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import editTiming from '../assets/edit-timing.png';
import letsGroove from '../assets/lets-groove.png';
import { BETA_URL, IS_BETA } from '../site';

const features = [
  {
    title: 'The hardware clock',
    body: 'Metronomo uses your device’s audio clock so beats stay on time and work offline.',
  },
  {
    title: 'Rhythm not notation',
    body: 'Set up to 16 beats a bar and accent each beat and subdivision however you like.',
  },
  {
    title: '20 to 480 BPM',
    body: 'Fine tune to specific BPM with easy jumps to faster and slower tempos.',
  },
  {
    title: 'Customizable subdivisions',
    body: 'One to eight slots per beat, each independently accented.',
  },
  {
    title: 'Multiple timers',
    body: 'Elapsed time, alarm, and pause timing include count-in bars, so you can pick up wherever you left off.',
  },
  {
    title: 'Grooves you re-use',
    body: 'Save any set of tempo, accents, subdivisions, and timers. Or hit “Let’s Groove” and go with the flow.',
  },
];
---

<Base
  title="Metronomo — a precise, offline metronome for musicians"
  description="A metronome built on beats and accents rather than time signatures, scheduled against the audio hardware clock so the click does not drift. Free on Android, works entirely offline."
>
  <div class="shell">
    <section class="hero">
      <div>
        {IS_BETA && <p class="beta-banner">Now in beta testing</p>}
        <h1>The bot that bops</h1>
        <p class="lede">
          Metronomo wraps hardware clock timing
          around custom beats.
          Jump over the noise and syncopate your groove.
        </p>
        <a class="cta" href={BETA_URL}>Join the beta</a>
        <ul class="cta-list">
          <li>Free foundational engine</li>
          <li>No ads, no PII</li>
          <li>Local, offline, on-the-go</li>
        </ul>
      </div>
      <div class="hero-shot">
        <Image
          src={letsGroove}
          width={672}
          alt="Metronomo's main screen, showing the tempo dial, beat row, and transport controls"
          widths={[336, 672]}
          sizes="(max-width: 46rem) 17rem, 21rem"
        />
      </div>
    </section>
  </div>

  <div class="shell">
    <dl class="claims">
      <div>
        <dt>20&ndash;480</dt>
        <dd>BPM on a fine-tuned slider window</dd>
      </div>
      <div>
        <dt>1&ndash;16</dt>
        <dd>beats a bar, each independently accented</dd>
      </div>
      <div>
        <dt>0</dt>
        <dd>ads or extra signups to make a sound</dd>
      </div>
    </dl>
  </div>

  <div class="shell">
    <section class="section">
      <h2>Built for making music, not for reading music</h2>
      <p class="sub">
        Most metronome apps start with presets and time signatures.
        Metronomo prioritizes rhythm over rote: your choice of beats and subdivisions each with a customizable weight.
      </p>
      <ul class="features">
        {
          features.map((feature) => (
            <li>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="shell">
    <section class="section split">
      <div>
        <h2>Play and put the phone aside</h2>
        <p class="sub">
          Practice needs your full attention.
          Metronomo keeps running when your screen sleeps.
          Other features that match your method?
          Light and dark themes; independent volume control;
          percussive or tonal beats; more to come!
        </p>
      </div>
      <div class="hero-shot">
        <Image
          src={editTiming}
          width={608}
          alt="Metronomo's groove timing editor, showing alarm and pause timer controls"
          widths={[304, 608]}
          sizes="(max-width: 46rem) 17rem, 19rem"
          loading="lazy"
        />
      </div>
    </section>
  </div>

  <div class="shell">
    <section class="section">
      <h2>Your practice is your business</h2>
      <p class="sub">
        Metronomo needs no buy-in, other than the buy-in of giving it a try:
      </p>
      <ul class="privacy-list">
        <li>No name, no email address, no personal information of any kind.</li>
        <li>No creative work saved in the cloud. Your grooves stay on your device.</li>
        <li>No microphone permission. Metronomo makes sound; it never listens.</li>
        <li>No ads, no outbound tracking.</li>
        <li>
          Yes to some anonymous analytics. Analytics can be switched off in Settings —
          what they cover is spelled out in the <a href="/privacy">Privacy Policy</a>.
        </li>
      </ul>
    </section>
  </div>
</Base>
