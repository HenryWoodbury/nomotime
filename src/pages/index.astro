---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import letsGroove from '../assets/lets-groove.png';
import { BETA_URL, IS_BETA } from '../site';

const features = [
  {
    title: 'Hardware clock',
    body: 'Practice against your device’s audio clock for the best precision, even offline.',
  },
  {
    title: '16 beats a bar',
    body: 'Accent each beat to generate unique rhythms.',
  },
  {
    title: '20 to 480 BPM',
    body: 'Quickly fine-tune to specific tempos.',
  },
  {
    title: 'Custom subdivisions',
    body: 'Select one to eight subdivisions per beat on their own pattern.',
  },
  {
    title: 'Multiple timers',
    body: 'Set alarm and pause timers, as well as count-in bars.',
  },
  {
    title: 'Grooves you re-use',
    body: 'Save any set of tempo, accents, subdivisions, and timers.',
  },
];
---

<Base
  title="Metronomo — a precise, offline metronome for musicians"
  description="A metronome built on beats and accents, scheduled against the audio hardware clock so the click does not drift. Free on Android, works entirely offline."
>
  <div class="shell">
    <section class="hero">
      <div>
        {IS_BETA && <p class="beta-banner">Now in beta testing</p>}
        <h1>The bot that bops</h1>
        <p class="lede">
          Metronomo wraps hardware clock timing
          around custom beats.
          Jump over the noise and syncopate your groove.
        </p>
        <a class="cta" href={BETA_URL}>Join the beta</a>
        <ul class="cta-list">
          <li>Free foundational engine, 20&ndash;480 BPM</li>
          <li>No ads, no signup, no personal info</li>
          <li>Local, offline, on-the-go</li>
        </ul>
      </div>
      <div class="hero-shot">
        <Image
          src={letsGroove}
          width={672}
          alt="Metronomo's main screen, showing the tempo dial, beat row, and transport controls"
          widths={[336, 672]}
          sizes="(max-width: 46rem) 17rem, 21rem"
        />
      </div>
    </section>
  </div>

  <div class="shell">
    <dl class="features">
      {
        features.map((feature) => (
          <div>
            <dt>{feature.title}</dt>
            <dd>{feature.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="shell">
    <section class="section">
      <h2>Your practice is your business</h2>
      <p class="sub">
        Metronomo needs no buy-in, other than the buy-in of giving it a try:
      </p>
      <ul class="privacy-list">
        <li>No name, no email address, no personal information of any kind.</li>
        <li>No creative work saved in the cloud. Your grooves stay on your device.</li>
        <li>No microphone permission. Metronomo makes sound; it never listens.</li>
        <li>No ads, no tracking.</li>
        <li>
          Yes to some anonymous analytics. Analytics can be switched off in Settings —
          what they cover is spelled out in the <a href="/privacy">Privacy Policy</a>.
        </li>
      </ul>
    </section>
  </div>
</Base>
